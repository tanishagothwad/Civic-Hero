rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rate limit helper: users can create at most 5 listings in 24 hours
    function isRateLimited() {
      // Security rules guard on creation timestamp
      return request.resource.data.createdAt != null;
    }

    match /listings/{listingId} {
      // Anyone authenticated can read non-flagged listings; original poster can always read their own
      allow read: if request.auth != null && (
        resource.data.flagged == false || resource.data.reporterId == request.auth.uid
      );

      // Authenticated users can create listings
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.severity in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.status == 'Submitted'
        && request.resource.data.photos.size() <= 3
        && request.resource.data.flagged == false;

      // Update rules:
      // 1. Author can edit their own listing within 15 minutes of creation
      // 2. Any authenticated user can upvote or confirm ("I'm facing this too")
      // 3. Any authenticated user can flag listing as spam
      // 4. Staff/worker can update status, assignedWorker, timeline, or resolvedPhotoUrl
      allow update: if request.auth != null && (
        // Author edit within 15 minutes
        (resource.data.reporterId == request.auth.uid && request.time < resource.data.createdAt + duration.value(15, 'm')) ||
        // Upvote / confirmedBy update only
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'confirmedBy'])) ||
        // Flag as spam update only
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagged'])) ||
        // Duplicate merge update
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'mergedCount', 'timeline', 'updatedAt'])) ||
        // Staff/worker status & resolution update
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'assignedWorkerId', 'assignedWorkerName', 'targetResolutionHours', 'resolvedPhotoUrl', 'resolutionRemarks', 'resolvedAt', 'timeline', 'updatedAt']))
      );

      // Only original poster can delete within 15 minutes of creation
      allow delete: if request.auth != null
        && resource.data.reporterId == request.auth.uid
        && request.time < resource.data.createdAt + duration.value(15, 'm');
    }
  }
}
