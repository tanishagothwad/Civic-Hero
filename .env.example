# Firebase Client Configuration for Civic Hero
# Replace these placeholder values with your Firebase Project Configuration
# Available in Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=civic-hero-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civic-hero-app
VITE_FIREBASE_STORAGE_BUCKET=civic-hero-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
